---
import { Image } from 'astro:assets';
import EntryPager from '../components/EntryPager.astro';
import EntryTitleBlock from '../components/EntryTitleBlock.astro';
import type { AdjacentEntries, Entry } from '../lib/entries';
import BaseLayout from './BaseLayout.astro';

type Props = AdjacentEntries & {
	entry: Entry;
};

const { entry, previous, next } = Astro.props;
const { title, description, heroImage } = entry.post.data;
---

<BaseLayout title={title} description={description} image={heroImage} ogType="article">
	<article>
		<EntryTitleBlock entry={entry} />
		{
			heroImage && (
				<Image
					class="hero-image"
					src={heroImage}
					alt=""
					widths={[768, 1536]}
					sizes="(min-width: 52rem) 48rem, calc(100vw - 2.5rem)"
					loading="eager"
					fetchpriority="high"
				/>
			)
		}
		<div class="prose">
			<slot />
		</div>
	</article>
	<EntryPager previous={previous} next={next} />
</BaseLayout>
<style>
	article :global(.hero-image) {
		width: 100%;
		margin-top: calc(var(--grid) * 2);
	}
	.prose {
		margin-top: calc(var(--grid) * 2);
	}
</style>
