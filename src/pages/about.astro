---
import { SOCIAL_LINKS, TOPICS } from '../consts';
import Page from '../layouts/Page.astro';
import { topicUrl } from '../lib/entries';

const github = SOCIAL_LINKS.find((link) => link.label === 'GitHub');
---

<Page title="About" description="Kai Chen is an iOS engineer in the San Francisco Bay Area.">
	<p>I'm Kai Chen, an iOS engineer in the San Francisco Bay Area.</p>
	<p>
		This site is my decision log. I write down what I believe and why before I know how it turns
		out, so I can come back later and check what held up. I mostly write about three things:
	</p>
	<ul>
		{
			TOPICS.map((topic) => (
				<li>
					<a href={topicUrl(topic.slug)}>{topic.label}</a>: {topic.summary}
				</li>
			))
		}
	</ul>
	{
		github && (
			<p>
				You can also find my code on <a href={github.href}>GitHub</a>.
			</p>
		)
	}
</Page>
