---
import EntryList from '../components/EntryList.astro';
import TopicNav from '../components/TopicNav.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntries } from '../lib/entries';

const LATEST_COUNT = 5;

const entries = await getEntries();
const latest = entries.slice(0, LATEST_COUNT);
---

<BaseLayout>
	<section class="intro" aria-labelledby="intro-title">
		<h1 id="intro-title">A decision log on engineering, investing, and thinking.</h1>
		<p class="lede">
			I'm Kai Chen, an iOS engineer in the San Francisco Bay Area. I write things down before I know
			how they turn out, then come back to see what held up.
		</p>
	</section>

	<section class="latest" aria-labelledby="latest-title">
		<div class="section-head">
			<h2 id="latest-title">Latest entries</h2>
			<TopicNav />
		</div>
		<EntryList entries={latest} />
		{entries.length > LATEST_COUNT && <a class="all-entries" href="/blog/">All entries</a>}
	</section>
</BaseLayout>
<style>
	.intro {
		padding-block: calc(var(--grid) * 1) calc(var(--grid) * 4);
	}
	h1 {
		max-width: 13em;
		font-size: var(--text-3xl);
		line-height: 1.02;
		letter-spacing: -0.01em;
	}
	.lede {
		max-width: 30em;
		margin-top: calc(var(--grid) * 1.5);
		font-size: var(--text-lead);
		line-height: 1.55;
	}
	.section-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		margin-bottom: 0.75rem;
	}
	h2 {
		font-size: var(--text-lg);
	}
	.all-entries {
		display: inline-block;
		margin-top: 1.25rem;
		font-family: var(--font-lettering);
		font-size: var(--text-body);
		font-weight: 600;
	}
</style>
