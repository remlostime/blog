---
import { render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { type AdjacentEntries, type Entry, getAdjacentEntries, getEntries } from '../../lib/entries';

export async function getStaticPaths() {
	const entries = await getEntries();
	return entries.map((entry) => ({
		params: { slug: entry.post.id },
		props: { entry, ...getAdjacentEntries(entries, entry.post.id) },
	}));
}

type Props = AdjacentEntries & { entry: Entry };

const { entry, previous, next } = Astro.props;
const { Content } = await render(entry.post);
---

<BlogPost entry={entry} previous={previous} next={next}>
	<Content />
</BlogPost>
