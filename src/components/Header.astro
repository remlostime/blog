---
import { SITE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header">
	<nav class="wrap" aria-label="Main">
		<a class="wordmark" href="/">{SITE.title}</a>
		<ul class="nav-links" role="list">
			<li><HeaderLink href="/blog">Entries</HeaderLink></li>
			<li><HeaderLink href="/about">About</HeaderLink></li>
			<li><HeaderLink href="/rss.xml">RSS</HeaderLink></li>
		</ul>
	</nav>
</header>
<style>
	/* Like the printed band at the top of a pad: solid paper, no grid. */
	.site-header {
		background-color: var(--pad);
		border-bottom: 1px solid var(--rule);
		font-family: var(--font-lettering);
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		min-height: calc(var(--grid) * 3);
	}
	.wordmark {
		color: var(--ink);
		font-size: var(--text-lg);
		font-weight: 600;
		text-decoration: none;
	}
	.nav-links {
		display: flex;
		gap: 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: var(--text-body);
		font-weight: 500;
	}
	@media (max-width: 26rem) {
		.nav-links {
			gap: 1.1rem;
		}
	}
</style>
