---
import { getTopic } from '../consts';
import { type Entry, entryUrl, formatEntryNumber, topicUrl } from '../lib/entries';
import { getLocale, LOCALE_META } from '../lib/i18n';
import { ui } from '../lib/ui';
import FormattedDate from './FormattedDate.astro';
import LanguageTag from './LanguageTag.astro';

interface Props {
	entries: Entry[];
	/** Hide the topic column, e.g. on a topic page where every row shares it. */
	showTopic?: boolean;
}

const { entries, showTopic = true } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = ui(locale);
---

<ol class:list={['entry-list', { 'without-topic': !showTopic }]} role="list">
	{
		entries.map((entry) => {
			const { post, number } = entry;
			const topic = getTopic(post.data.topic, locale);
			// An entry not yet translated links to its original, so its title is marked with that language.
			const foreign = entry.locale !== locale ? LOCALE_META[entry.locale].htmlLang : undefined;
			return (
				<li class="entry-row">
					<span class="entry-number">
						<span class="sr-only">{t.entry.label} </span>
						{number ? formatEntryNumber(number) : t.entry.draft}
					</span>
					<FormattedDate class="entry-date" date={post.data.pubDate} />
					<a class="entry-title" href={entryUrl(post)} hreflang={foreign}>
						<span lang={foreign}>{post.data.title}</span>
						<LanguageTag locale={entry.locale} />
					</a>
					{showTopic && (
						<a class="entry-topic" href={topicUrl(locale, topic.slug)}>
							{topic.label}
						</a>
					)}
				</li>
			);
		})
	}
</ol>
<style>
	/* Ledger rows: number, date, title, topic. */
	.entry-list {
		/* Fits "Nov 19, 2026"; Chinese dates (2026年11月19日) need a little more. */
		--date-column: 6.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--rule);
		font-family: var(--font-lettering);
	}
	.entry-list:lang(zh) {
		--date-column: 7.5rem;
	}
	.entry-row {
		display: grid;
		grid-template-columns: 2.75rem var(--date-column) minmax(0, 1fr) auto;
		grid-template-areas: 'number date title topic';
		align-items: baseline;
		column-gap: 1.25rem;
		padding-block: 1.05rem;
		background-color: var(--pad);
		border-bottom: 1px solid var(--rule);
	}
	.without-topic .entry-row {
		grid-template-columns: 2.75rem var(--date-column) minmax(0, 1fr);
		grid-template-areas: 'number date title';
	}
	.entry-number,
	.entry-row :global(.entry-date),
	.entry-topic {
		color: var(--graphite);
		font-size: var(--text-base);
		font-variant-numeric: tabular-nums;
		font-weight: 500;
	}
	.entry-number {
		grid-area: number;
	}
	.entry-row :global(.entry-date) {
		grid-area: date;
	}
	.entry-title {
		grid-area: title;
		color: var(--ink);
		font-size: var(--text-lead);
		font-weight: 600;
		line-height: 1.2;
		text-decoration: none;
		text-wrap: pretty;
	}
	/* Two-line Chinese titles need more leading than Latin ones. */
	.entry-title:lang(zh),
	.entry-title:has(:lang(zh)) {
		line-height: 1.35;
	}
	.entry-title:hover {
		color: var(--royal-ink);
		text-decoration: underline 2px;
		text-underline-offset: 0.2em;
	}
	.entry-topic {
		grid-area: topic;
		justify-self: end;
		text-decoration: none;
	}
	.entry-topic:hover {
		color: var(--ink);
		text-decoration: underline 1px var(--graphite);
		text-underline-offset: 0.35em;
	}
	@media (max-width: 40rem) {
		.entry-row,
		.without-topic .entry-row {
			grid-template-columns: auto auto minmax(0, 1fr);
			grid-template-areas:
				'number date topic'
				'title title title';
			row-gap: 0.35rem;
			column-gap: 1rem;
		}
	}
</style>
