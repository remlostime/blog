---
import { type AdjacentEntries, type Entry, entriesUrl, entryUrl } from '../lib/entries';
import { getLocale, LOCALE_META } from '../lib/i18n';
import { ui } from '../lib/ui';
import LanguageTag from './LanguageTag.astro';

type Props = AdjacentEntries;

const { previous, next } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = ui(locale);

/** `lang` for a neighbour written in another language, which links to its original. */
const foreign = (entry: Entry) => (entry.locale !== locale ? LOCALE_META[entry.locale].htmlLang : undefined);
---

<nav class="pager" aria-label={t.pager.label}>
	{
		previous && (
			<a class="pager-link previous" href={entryUrl(previous.post)} rel="prev" hreflang={foreign(previous)}>
				<span class="pager-label">{t.pager.previous}</span>
				<span class="pager-title">
					<span lang={foreign(previous)}>{previous.post.data.title}</span>
					<LanguageTag locale={previous.locale} />
				</span>
			</a>
		)
	}
	{
		next && (
			<a class="pager-link next" href={entryUrl(next.post)} rel="next" hreflang={foreign(next)}>
				<span class="pager-label">{t.pager.next}</span>
				<span class="pager-title">
					<span lang={foreign(next)}>{next.post.data.title}</span>
					<LanguageTag locale={next.locale} />
				</span>
			</a>
		)
	}
	{
		!previous && !next && (
			<a class="pager-link" href={entriesUrl(locale)}>
				<span class="pager-title">{t.pager.all}</span>
			</a>
		)
	}
</nav>
<style>
	.pager {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.5rem;
		margin-top: calc(var(--grid) * 3);
		padding-top: 1.25rem;
		border-top: 1px solid var(--rule);
		font-family: var(--font-lettering);
	}
	.pager-link {
		display: grid;
		gap: 0.2rem;
		align-content: start;
		color: var(--ink);
		text-decoration: none;
	}
	.next {
		grid-column: 2;
		text-align: right;
	}
	.pager-label {
		color: var(--graphite);
		font-size: var(--text-sm);
		font-weight: 500;
	}
	.pager-title {
		font-size: var(--text-lead);
		font-weight: 600;
		line-height: 1.2;
		text-wrap: balance;
	}
	.pager-title:lang(zh),
	.pager-title:has(:lang(zh)) {
		line-height: 1.35;
	}
	.pager-link:hover .pager-title {
		color: var(--royal-ink);
		text-decoration: underline 2px;
		text-underline-offset: 0.2em;
	}
	@media (max-width: 34rem) {
		.pager {
			grid-template-columns: 1fr;
		}
		.next {
			grid-column: auto;
			text-align: left;
		}
	}
</style>
