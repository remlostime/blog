---
import { getTopic } from '../consts';
import { type Entry, entryUrl, formatEntryNumber, topicUrl } from '../lib/entries';
import { getLocale, LOCALE_META, LOCALES } from '../lib/i18n';
import { ui } from '../lib/ui';
import FormattedDate from './FormattedDate.astro';

interface Props {
	entry: Entry;
}

const { entry } = Astro.props;
const { title, pubDate, updatedDate } = entry.post.data;
const locale = getLocale(Astro.currentLocale);
const t = ui(locale);
const topic = getTopic(entry.post.data.topic, locale);
const versions = LOCALES.flatMap((versionLocale) => {
	const post = entry.versions[versionLocale];
	return post ? [{ locale: versionLocale, post, ...LOCALE_META[versionLocale] }] : [];
});
---

<!-- Modeled on the printed title block at the top of a computation pad sheet. -->
<header class="title-block">
	<dl class="fields">
		<div class="field">
			<dt>{t.entry.label}</dt>
			<dd>{entry.number ? formatEntryNumber(entry.number) : t.entry.draft}</dd>
		</div>
		<div class="field">
			<dt>{t.entry.topic}</dt>
			<dd><a href={topicUrl(locale, topic.slug)}>{topic.label}</a></dd>
		</div>
		<div class="field">
			<dt>{t.entry.date}</dt>
			<dd><FormattedDate date={pubDate} /></dd>
		</div>
		{
			updatedDate && (
				<div class="field updated">
					<dt>{t.entry.updated}</dt>
					<dd>
						<FormattedDate date={updatedDate} />
					</dd>
				</div>
			)
		}
		<div class="field">
			<dt>{t.entry.language}</dt>
			<dd>
				<!-- Like a form option circled in red pencil: the language you're reading. -->
				<ul class="languages" role="list">
					{
						versions.map((version) => (
							<li>
								{version.locale === locale ? (
									<span class="current" aria-current="true" lang={version.htmlLang}>
										{version.endonym}
									</span>
								) : (
									<a href={entryUrl(version.post)} lang={version.htmlLang} hreflang={version.htmlLang}>
										{version.endonym}
									</a>
								)}
							</li>
						))
					}
				</ul>
			</dd>
		</div>
	</dl>
	<h1>{title}</h1>
</header>
<style>
	.title-block {
		background-color: var(--pad);
		border: 1px solid var(--graphite);
		font-family: var(--font-lettering);
	}
	/* Fields wrap onto as many rows as they need; the 1px gaps show the graphite behind them as printed lines. */
	.fields {
		display: flex;
		flex-wrap: wrap;
		gap: 1px;
		margin: 0;
		background-color: var(--graphite);
		border-bottom: 1px solid var(--graphite);
	}
	.field {
		flex: 1 1 auto;
		padding: 0.45rem 0.85rem 0.55rem;
		background-color: var(--pad);
	}
	dt {
		color: var(--graphite);
		font-size: var(--text-sm);
		font-weight: 500;
		line-height: 1.3;
	}
	dd {
		margin: 0;
		font-size: var(--text-body);
		font-variant-numeric: tabular-nums;
		font-weight: 600;
		line-height: 1.4;
		white-space: nowrap;
	}
	dd a {
		color: var(--ink);
		text-decoration-color: var(--graphite);
	}
	dd a:hover {
		color: var(--royal-ink);
		text-decoration-color: currentColor;
	}
	.updated dd {
		color: var(--red-pencil);
	}
	.languages {
		display: flex;
		gap: 1.1em;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.current {
		position: relative;
	}
	/* A hand-drawn loop: uneven radii and a slight tilt keep it from reading as a UI pill. */
	.current::after {
		content: '';
		position: absolute;
		inset: -0.2em -0.5em -0.14em;
		border: 1.5px solid var(--red-pencil);
		border-radius: 50% 46% 52% 48% / 58% 52% 48% 42%;
		transform: rotate(-4deg);
		pointer-events: none;
	}
	h1 {
		padding: 1.1rem 0.85rem 1.3rem;
		font-size: var(--text-2xl);
		line-height: 1.05;
	}
	h1:lang(zh) {
		line-height: 1.25;
	}
</style>
