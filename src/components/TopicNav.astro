---
import { TOPICS, type TopicSlug } from '../consts';
import { topicUrl } from '../lib/entries';

interface Props {
	current?: TopicSlug;
}

const { current } = Astro.props;
---

<nav class="topic-nav" aria-label="Topics">
	<ul role="list">
		{
			TOPICS.map((topic) => (
				<li>
					<a
						href={topicUrl(topic.slug)}
						class:list={{ active: topic.slug === current }}
						aria-current={topic.slug === current ? 'page' : undefined}
					>
						{topic.label}
					</a>
				</li>
			))
		}
	</ul>
</nav>
<style>
	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-family: var(--font-lettering);
		font-size: var(--text-base);
		font-weight: 500;
	}
	a {
		color: var(--graphite);
		text-decoration: none;
	}
	a:hover {
		color: var(--ink);
		text-decoration: underline 1px var(--graphite);
		text-underline-offset: 0.35em;
	}
	a.active {
		color: var(--ink);
		text-decoration: underline 2px var(--red-pencil);
		text-underline-offset: 0.35em;
	}
</style>
