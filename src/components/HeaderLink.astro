---
import type { HTMLAttributes } from 'astro/types';
import { LOCALES, localizePath } from '../lib/i18n';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;

const withoutTrailingSlash = (path: string) => path.replace(/\/+$/, '') || '/';
const currentPath = withoutTrailingSlash(Astro.url.pathname);
const targetPath = withoutTrailingSlash(String(href));
const homePaths = LOCALES.map((locale) => withoutTrailingSlash(localizePath(locale, '/')));

// "Entries" stays active on every entry page under /blog/ (or /zh/blog/). A home link is only active on itself.
const isCurrentPage = currentPath === targetPath;
const isActive = isCurrentPage || (!homePaths.includes(targetPath) && currentPath.startsWith(`${targetPath}/`));
const ariaCurrent = isCurrentPage ? 'page' : isActive ? 'true' : undefined;
---

<a href={href} class:list={[className, { active: isActive }]} aria-current={ariaCurrent} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		color: var(--ink);
		text-decoration: none;
	}
	a:hover {
		text-decoration: underline 1px var(--graphite);
		text-underline-offset: 0.35em;
	}
	a.active {
		text-decoration: underline 2px var(--red-pencil);
		text-underline-offset: 0.35em;
	}
</style>
