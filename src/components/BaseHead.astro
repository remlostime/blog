---
// Fonts and global styles load here, so every page that renders <BaseHead /> gets them.
import '@fontsource/barlow-semi-condensed/500.css';
import '@fontsource/barlow-semi-condensed/600.css';
import '@fontsource-variable/literata/opsz.css';
import '@fontsource-variable/literata/opsz-italic.css';
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { SITE } from '../consts';
import { type Alternates, feedUrl, getLocale, LOCALE_META, LOCALES } from '../lib/i18n';
import { ui } from '../lib/ui';

export interface Props {
	/** Page name. Omit on the home page to use the site title alone. */
	title?: string;
	description?: string;
	image?: ImageMetadata;
	ogType?: 'website' | 'article';
	/** This page in each locale it exists in. Drives the canonical URL and `hreflang` links. */
	alternates: Alternates;
}

const locale = getLocale(Astro.currentLocale);
const { title, description = SITE.description[locale], image, ogType = 'website', alternates } = Astro.props;

const absolute = (path: string) => new URL(path, Astro.site);
const pageTitle = title ? `${title} | ${SITE.title}` : SITE.title;
const canonicalURL = absolute(alternates[locale] ?? Astro.url.pathname);
const imageURL = image ? absolute(image.src) : undefined;
// Only pages that exist in more than one language get hreflang links.
const translated = LOCALES.filter((candidate) => alternates[candidate]);
const languageLinks = translated.length > 1 ? translated : [];
const defaultLanguageURL = languageLinks.length > 0 ? absolute(alternates.en ?? alternates[languageLinks[0]]!) : undefined;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#f2f5ed" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={ui(locale).feed.title} href={absolute(feedUrl(locale))} />
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL and translations -->
<link rel="canonical" href={canonicalURL} />
{
	languageLinks.map((candidate) => (
		<link rel="alternate" hreflang={LOCALE_META[candidate].htmlLang} href={absolute(alternates[candidate]!)} />
	))
}
{defaultLanguageURL && <link rel="alternate" hreflang="x-default" href={defaultLanguageURL} />}

<!-- Primary Meta Tags -->
<title>{pageTitle}</title>
<meta name="title" content={pageTitle} />
<meta name="description" content={description} />
<meta name="author" content={SITE.author} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:locale" content={LOCALE_META[locale].ogLocale} />
{
	languageLinks
		.filter((candidate) => candidate !== locale)
		.map((candidate) => <meta property="og:locale:alternate" content={LOCALE_META[candidate].ogLocale} />)
}
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
{imageURL && <meta property="og:image" content={imageURL} />}

<!-- Twitter -->
<meta property="twitter:card" content={imageURL ? 'summary_large_image' : 'summary'} />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={pageTitle} />
<meta property="twitter:description" content={description} />
{imageURL && <meta property="twitter:image" content={imageURL} />}
