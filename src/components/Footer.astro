---
import { SITE } from '../consts';
import SocialLinks from './SocialLinks.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="wrap footer-inner">
		<p>&copy; {year} {SITE.author}</p>
		<SocialLinks />
	</div>
</footer>
<style>
	.site-footer {
		margin-top: auto;
		background-color: var(--pad);
		border-top: 1px solid var(--rule);
		color: var(--graphite);
		font-family: var(--font-lettering);
		font-size: var(--text-base);
		font-weight: 500;
	}
	.footer-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		padding-block: 1.25rem 2.5rem;
	}
	/* Line the icons' visible edge up with the column edge. */
	.footer-inner :global(.social-links) {
		margin-right: -0.5rem;
	}
</style>
